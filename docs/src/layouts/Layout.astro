---
import '../styles/global.css';
import 'katex/dist/katex.min.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'SpiderCSS: Scalable Fault-Tolerant CSS State Preparation',
  description = 'Interactive compiler studio and benchmark explorer for SpiderCSS: Scalable Fault-Tolerant CSS State Preparation via ZX-calculus and fault-equivalent rewrites.',
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;600&family=Newsreader:ital,opsz,wght@0,6..72,500;0,6..72,600;1,6..72,400&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="min-h-screen flex flex-col">
    <header class="sticky top-0 z-40 border-b border-slate-200/80 bg-white/90 backdrop-blur-md">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 h-14 flex items-center justify-between">
        <a href="#" class="flex items-center gap-2.5 group">
          <span class="inline-flex items-center justify-center w-7 h-7 rounded-full bg-emerald-100 border-2 border-emerald-700 text-emerald-900 font-mono text-xs font-bold shadow-2xs group-hover:scale-105 transition-transform">
            Z
          </span>
          <span class="inline-flex items-center justify-center w-7 h-7 -ml-3 rounded-full bg-rose-100 border-2 border-rose-700 text-rose-900 font-mono text-xs font-bold shadow-2xs group-hover:scale-105 transition-transform">
            X
          </span>
          <span class="font-semibold tracking-tight text-slate-900 text-base">
            Spider<span class="text-emerald-700">CSS</span>
          </span>
          <span class="hidden sm:inline-block text-xs font-mono px-2 py-0.5 rounded-full bg-slate-100 text-slate-600 border border-slate-200">
            arXiv:2610.03714
          </span>
        </a>

        <nav class="flex items-center gap-1 sm:gap-4 text-sm font-medium text-slate-600">
          <a href="#overview" class="px-2.5 py-1.5 rounded-lg hover:text-slate-900 hover:bg-slate-100 transition-colors">
            Overview
          </a>
          <a href="#studio" class="px-2.5 py-1.5 rounded-lg hover:text-slate-900 hover:bg-slate-100 transition-colors">
            Interactive Studio
          </a>
          <a href="#benchmarks" class="px-2.5 py-1.5 rounded-lg hover:text-slate-900 hover:bg-slate-100 transition-colors">
            Benchmarks
          </a>
          <a
            href="https://github.com/boldar99/spidercss"
            target="_blank"
            rel="noopener noreferrer"
            class="ml-1 inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-slate-900 text-white text-xs font-semibold hover:bg-slate-800 transition-colors"
          >
            GitHub
          </a>
        </nav>
      </div>
    </header>

    <main class="flex-1">
      <slot />
    </main>

    <footer class="border-t border-slate-200 bg-white py-8 mt-16">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs text-slate-500">
        <div>
          <span class="font-semibold text-slate-700">SpiderCSS</span> — Scalable Fault-Tolerant CSS State Preparation
        </div>
        <div class="flex items-center gap-4">
          <a href="https://arxiv.org/abs/2610.03714" target="_blank" rel="noopener noreferrer" class="hover:text-slate-800 underline underline-offset-2">
            arXiv:2610.03714
          </a>
          <span>•</span>
          <a href="https://github.com/boldar99/spidercss" target="_blank" rel="noopener noreferrer" class="hover:text-slate-800 underline underline-offset-2">
            Source Code (Apache-2.0)
          </a>
        </div>
      </div>
    </footer>
  </body>
</html>
